# Secret references for the 1Password CLI. Resolve with:
#   op run --env-file=.env.1password -- <command>
# Edit the vault and item path to match your account. No secrets live in this file.
ANTHROPIC_API_KEY=op://Private/Anthropic API Key/credential

# Non-secret settings. Kept here so one file configures a run.
GENERATE_MODEL=claude-sonnet-5-5
GRADE_MODEL=claude-haiku-5-5
CHROMA_HOST=chroma
CHROMA_PORT=8000
